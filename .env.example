# ── Firebase (real backend) ─────────────────────────────────────────────
# Fill these in to use the real Firestore backend (the app's primary mode).
# Copy this file to .env to activate.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend switch:
#   firebase → Firebase Auth + Firestore (default; shared across all users/devices)
#   demo     → localStorage + sessionStorage (kept for the vitest suite)
VITE_BACKEND=firebase

# Cloudflare Worker that sends branded verification emails (optional).
VITE_VERIFY_EMAIL_URL=